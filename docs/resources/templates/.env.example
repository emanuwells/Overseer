# Copiar para secrets/.env e ajustar antes de arrancar (nunca versionar secrets/.env).
# Desenvolvimento local: docker compose --project-directory . --env-file secrets/.env -f docker/docker-compose.yml up -d

# --- API ---
OVERSEER_API_PORT=8090
OVERSEER_API_TOKEN=change-me-local-dev-token
OVERSEER_CORS_ORIGINS=*
OVERSEER_API_URL=http://127.0.0.1:8090

# --- Base de dados (dev: serviço mysql no Compose) ---
OVERSEER_DB_PORT=3307
MYSQL_ROOT_PASSWORD=overseer
MYSQL_PASSWORD=overseer
OVERSEER_DB_URL=mysql+pymysql://overseer:overseer@mysql:3306/Overseer?charset=utf8mb4

# --- Caminhos persistentes (dev: relativos ao repo) ---
OVERSEER_RUNTIME_DIR=./runtime
OVERSEER_RUNNERS_DIR=./deploy/runners

# --- Retenção de telemetria ---
OVERSEER_RETENTION_DAYS=30
OVERSEER_RETENTION_AUTO=true
OVERSEER_RETENTION_INTERVAL_HOURS=24

# --- Nomes de pipeline (prefixos removidos na API/UI/Slack) ---
OVERSEER_NAME_PREFIX_STRIP=Yunex 

# --- Slack (opcional) ---
# OVERSEER_SLACK_WEBHOOK_URL=https://example.invalid/slack/webhook/change-me
OVERSEER_SLACK_CHANNEL=#overseer
OVERSEER_SLACK_MENTION_CHANNEL=true
OVERSEER_SLACK_DIGEST_ENABLED=true
OVERSEER_SLACK_DIGEST_HOUR=8
OVERSEER_SLACK_DIGEST_MINUTE=30

# --- Sync SSH opcional ---
OVERSEER_SSH_SYNC_ENABLED=1

# --- Produção (exemplo; ajustar no servidor) ---
# OVERSEER_DB_URL=mysql+pymysql://user:password@127.0.0.1:3306/Overseer?charset=utf8mb4
# OVERSEER_RUNTIME_DIR=/var/lib/overseer/runtime
# OVERSEER_RUNNERS_DIR=/var/lib/overseer/runners
