# Configuração local do runner Overseer (não versionar com valores reais).
# Partilhada por todos os manifests no host: %USERPROFILE%\overseer-runners\.env.overseer
#
# Normalmente este ficheiro é GERADO automaticamente por:
#   scripts\windows\bootstrap-windows.ps1   (ou Initialize-OverseerEnv.ps1)
# que preenche URL, host_id (hostname) e token (via SSH do prod). Este exemplo
# serve só para referência ou override manual.
#
# A API central não é acessível diretamente: liga-se por túnel SSH em loopback.
# Ver scripts\windows\ssh-tunnel.ps1 (porta local 18090 -> 127.0.0.1:8090 no servidor).
OVERSEER_API_URL=http://127.0.0.1:18090
OVERSEER_API_TOKEN=change-me-api-token

# Identificador único desta máquina. Usado como sufixo do pipeline_id para
# distinguir o mesmo pipeline lógico em hosts diferentes (ex.: forms_sync__WIN-ETL01).
# Se vazio, o provisionamento usa o hostname normalizado.
OVERSEER_HOST_ID=

# Venv onde overseer-agent está instalado (opcional; default %LOCALAPPDATA%\overseer-venv).
# OVERSEER_VENV=C:\Users\operator\AppData\Local\overseer-venv
