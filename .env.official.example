# Overseer ligado a uma DB oficial existente.
# Copiar para `.env`, preencher valores reais e nunca versionar `.env`.

OVERSEER_API_PORT=8090
OVERSEER_API_TOKEN=change-me-api-token
OVERSEER_CORS_ORIGINS=*
OVERSEER_API_URL=http://127.0.0.1:8090

# URL SQLAlchemy do schema oficial Overseer.
# Exemplos:
# MariaDB/MySQL: mysql+pymysql://USER:PASSWORD@HOST:3306/Overseer?charset=utf8mb4
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/Overseer
OVERSEER_DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/Overseer?charset=utf8mb4

# O serviço mysql local pode continuar a existir no Compose, mas a API usará OVERSEER_DB_URL.
MYSQL_ROOT_PASSWORD=local-only-change-me
MYSQL_PASSWORD=local-only-change-me
