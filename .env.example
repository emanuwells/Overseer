# Overseer — ambiente local de desenvolvimento.
# Copiar para `.env` e ajustar valores. Nunca versionar `.env` com segredos reais.

OVERSEER_API_PORT=8090
OVERSEER_API_TOKEN=change-me-local-token
# CORS: lista de origens separadas por vírgula. Vazio ou '*' permite todas (não recomendado em produção).
OVERSEER_CORS_ORIGINS=*

# OpenAPI docs (desactivado por defeito em produção).
# OVERSEER_DOCS_ENABLED=false
OVERSEER_API_URL=http://127.0.0.1:8090

# MariaDB local via Docker Compose (valores por defeito do compose).
OVERSEER_DB_URL=mysql+pymysql://overseer:overseer@mysql:3306/Overseer?charset=utf8mb4
MYSQL_ROOT_PASSWORD=overseer
MYSQL_PASSWORD=overseer
OVERSEER_DB_PORT=3307

# Sync remoto de runners (requer chave SSH no host/container).
OVERSEER_SSH_SYNC_ENABLED=1

# Slack (opcional — ver COMMANDS.md).
# OVERSEER_SLACK_WEBHOOK_URL=
# OVERSEER_SLACK_CHANNEL=#overseer
# OVERSEER_SLACK_DIGEST_ENABLED=true
# OVERSEER_SLACK_DIGEST_HOUR=8
# OVERSEER_SLACK_DIGEST_MINUTE=30

# Para DB oficial existente, usar `.env.official.example` como base.
