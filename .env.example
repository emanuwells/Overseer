APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Base de dados — valores fictícios
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=example_database
DB_USERNAME=example_user
DB_PASSWORD=example_password

# Tokens — usar valores reais apenas no ambiente local/secret manager
EXTERNAL_API_KEY=example_api_key

# Overseer API
OVERSEER_API_TOKEN=example_overseer_token
OVERSEER_DB_URL=mysql+pymysql://overseer:example_password@localhost:3306/Overseer?charset=utf8mb4

# Slack (#overseer) — webhook apenas em .env local ou secrets/slack.json (nunca versionar URL real)
OVERSEER_SLACK_WEBHOOK_URL=
OVERSEER_SLACK_CHANNEL=#overseer
OVERSEER_SLACK_MENTION_CHANNEL=true
OVERSEER_SLACK_DIGEST_ENABLED=true
OVERSEER_SLACK_DIGEST_HOUR=8
OVERSEER_SLACK_DIGEST_MINUTE=30

# Sync remoto de runners (SSH)
OVERSEER_SSH_SYNC_ENABLED=1
