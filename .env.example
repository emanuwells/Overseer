# Overseer API
OVERSEER_API_HOST=0.0.0.0
OVERSEER_API_PORT=8090
OVERSEER_API_TOKEN=change-me-local-token
OVERSEER_CORS_ORIGINS=*
OVERSEER_API_URL=http://127.0.0.1:8090

# Slack (pipeline FAILED alerts)
# OVERSEER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# OVERSEER_SLACK_CHANNEL=#overseer
# OVERSEER_MAIATRON_RUN_URL=http://baze2.cm-maia.pt/MAIATRON-HUB/apps/overseer/?view=runs&run={row_id}

# Database
# Docker local: deixar OVERSEER_DB_URL vazio para usar o serviço mysql do compose.
# DB oficial: preencher com a URL SQLAlchemy real do schema Overseer, sem versionar `.env`.
# OVERSEER_DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/Overseer?charset=utf8mb4
OVERSEER_DB_HOST=127.0.0.1
OVERSEER_DB_PORT=3307
OVERSEER_DB_USER=overseer
OVERSEER_DB_PASSWORD=overseer
OVERSEER_DB_NAME=Overseer

# Docker local
MYSQL_ROOT_PASSWORD=overseer
MYSQL_PASSWORD=overseer
