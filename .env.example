APP_ENV=production
APP_BASE_URL=https://monitor.seu-dominio.pt

# Opcional: se definido, sobrepoe secrets/database.json
DB_URL=mysql+pymysql://monitor_user:change-me@127.0.0.1:3306/monitor_db?charset=utf8mb4
RUNS_TABLE=logs

# overseer_monitor (opcional; se vazio, tenta secrets/database.json e secrets/slack.json)
P_MONITOR_DB_HOST=127.0.0.1
P_MONITOR_DB_PORT=3306
P_MONITOR_DB_USER=monitor_user
P_MONITOR_DB_PASSWORD=change-me
P_MONITOR_DB_NAME=monitor_db
P_MONITOR_DB_CHARSET=utf8mb4
P_MONITOR_TABLE=logs
P_MONITOR_SLACK_CONFIG=secrets/slack.json
P_MONITOR_FRONTEND_URL=https://monitor.seu-dominio.pt/apps/overseer/PM.html
P_MONITOR_MODULE_TABLE=pipeline_module_events

WATERMARK_SLA_MINUTES=30
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_DEFAULT_TIMEOUT_SEC=3600
ORCHESTRATOR_DEFAULT_RETRY_MAX=2
ORCHESTRATOR_DEFAULT_CONCURRENCY=1


